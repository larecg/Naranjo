{
  "name": "naranjo",
  "version": "0.5.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Multi-provider AI text processing directly in your browser",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "tslib": "^2.7.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "@types/webextension-polyfill": "^0.12.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lefthook": "^2.1.6",
    "rimraf": "^6.0.1",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.0"
  },
  "scripts": {
    "build": "npm run clean:build && npm run build:extension && npm run build:service-worker && npm run build:content-script",
    "build:content-script": "tsc && vite build --config vite-config/content-script.ts",
    "build:service-worker": "tsc && vite build --config vite-config/service-worker.ts",
    "build:extension": "tsc && vite build --config vite-config/extension.ts",
    "clean:build": "rimraf dist tsconfig.tsbuildinfo",
    "test": "jest --runInBand --forceExit --detectOpenHandles --verbose --bail",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit --detectOpenHandles --verbose",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "lint:ci": "eslint src test --max-warnings 0",
    "ts-check": "tsc --noEmit --skipLibCheck",
    "ts-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "prepare": "lefthook install",
    "version": "node --input-type=commonjs -e \"const fs=require('fs');const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;const p='docs/index.html';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/(<span class=\\\"version-badge\\\">)v[\\d.]+(<\\/span>)/,'\\$1v'+v+'\\$2'),'utf8');\" && git add docs/index.html"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
